# TIH Shopify Ops
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_URL=https://your-public-https-url.example
SHOPIFY_AUTH_PORT=3000

# Required by the deployed callback and local token synchronisation.
SHOPIFY_MCP_SYNC_SECRET=
SHOPIFY_SESSION_ENCRYPTION_KEY=

# Provisioned automatically by the Vercel Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional aliases when connecting to Upstash outside Vercel.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional overrides
# SHOPIFY_SCOPES=read_products,write_products
# SHOPIFY_TOKEN_STORE_PATH=/absolute/path/to/shopify-session.json
