{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": false,
    "incremental": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "plugins": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["app", "dist", "node_modules", "tests"]
}
