{
  "name": "tih-shopify-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Shopify OAuth gateway and local MCP server for The Inspire Home.",
  "type": "module",
  "main": "dist/mcp-server.js",
  "scripts": {
    "build": "pnpm build:mcp && pnpm build:web",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "build:web": "next build",
    "dev:auth": "tsx --env-file=../../.env src/auth-server.ts",
    "dev:mcp": "tsx --env-file=../../.env src/mcp-server.ts",
    "dev:web": "dotenv -e ../../.env -- next dev",
    "start:auth": "node --env-file=../../.env dist/auth-server.js",
    "start:mcp": "node --env-file=../../.env dist/mcp-server.js",
    "sync-token": "tsx --env-file=../../.env src/sync-token.ts",
    "sync-token:built": "node --env-file=../../.env dist/sync-token.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.mcp.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@upstash/redis": "^1.38.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
